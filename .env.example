APP_NAME="Customer Feedback & Complaint Management System"
DEBUG=false

# Choose one:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/feedback_db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/feedback_db
DATABASE_URL=sqlite:///./app.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dev convenience only (use Alembic migrations otherwise)
AUTO_CREATE_TABLES=false

SLA_WARNING_MINUTES=60
# Seconds between automatic SLA checks (0 = disabled; call POST /api/v1/sla/check from cron instead)
SLA_CHECK_INTERVAL_SECONDS=0
REOPEN_WINDOW_DAYS=7

# Bootstrap admin, created on startup if missing
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin12345
FIRST_ADMIN_NAME=System Admin
